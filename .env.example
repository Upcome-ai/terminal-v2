# Base URL of the Upcome backend.
#
# NOTE: the Auth API doc says the backend defaults to port 7070 (set the
# backend's PORT to change it), but the integration was requested against
# localhost:8080 — which is the default below. Point this at wherever your
# instance actually listens. The WebSocket origin is derived automatically
# (http -> ws, https -> wss).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Offline preview aid. When "true", a failed interests request falls back to
# bundled sample data (with a visible banner) so the terminal UI is usable
# without a live backend. Leave unset / "false" for a real integration.
NEXT_PUBLIC_USE_MOCK_FALLBACK=false
