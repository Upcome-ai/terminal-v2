# Base URL of the Wealth Frame backend. This is also the built-in default, so you only
# need to set it to point at a different instance (e.g. a local backend). The
# WebSocket origin is derived automatically (http -> ws, https -> wss).
NEXT_PUBLIC_API_BASE_URL=https://backend.upcome.ai

# Offline preview aid. When "true", a failed interests request falls back to
# bundled sample data (with a visible banner) so the terminal UI is usable
# without a live backend. Leave unset / "false" for a real integration.
NEXT_PUBLIC_USE_MOCK_FALLBACK=false
